#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x572d15eb3630 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x572d15eb37c0 .scope module, "mac_tb" "mac_tb" 3 3;
 .timescale -9 -12;
v0x572d15eceeb0_0 .var/s "a", 7 0;
v0x572d15ecef90_0 .var/s "b", 7 0;
v0x572d15ecf030_0 .var "clk", 0 0;
v0x572d15ecf0d0_0 .net/s "out", 31 0, v0x572d15ea43b0_0;  1 drivers
v0x572d15ecf1a0_0 .var "rst", 0 0;
S_0x572d15ea5580 .scope module, "dut" "mac" 3 11, 4 1 0, S_0x572d15eb37c0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst";
    .port_info 2 /INPUT 8 "a";
    .port_info 3 /INPUT 8 "b";
    .port_info 4 /OUTPUT 32 "out";
v0x572d15ea05f0_0 .net/s *"_ivl_0", 31 0, L_0x572d15ecf290;  1 drivers
v0x572d15ea1b50_0 .net/s *"_ivl_2", 31 0, L_0x572d15ecf3b0;  1 drivers
v0x572d15ea27a0_0 .net/s "a", 7 0, v0x572d15eceeb0_0;  1 drivers
v0x572d15ea2f70_0 .net/s "b", 7 0, v0x572d15ecef90_0;  1 drivers
v0x572d15ea3860_0 .net "clk", 0 0, v0x572d15ecf030_0;  1 drivers
v0x572d15ea43b0_0 .var/s "out", 31 0;
v0x572d15ea4be0_0 .net/s "product_ext", 31 0, L_0x572d15ecf4a0;  1 drivers
v0x572d15eced50_0 .net "rst", 0 0, v0x572d15ecf1a0_0;  1 drivers
E_0x572d15eb1f50 .event posedge, v0x572d15ea3860_0;
L_0x572d15ecf290 .extend/s 32, v0x572d15eceeb0_0;
L_0x572d15ecf3b0 .extend/s 32, v0x572d15ecef90_0;
L_0x572d15ecf4a0 .arith/mult 32, L_0x572d15ecf290, L_0x572d15ecf3b0;
    .scope S_0x572d15ea5580;
T_0 ;
    %wait E_0x572d15eb1f50;
    %load/vec4 v0x572d15eced50_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 32;
    %assign/vec4 v0x572d15ea43b0_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x572d15ea43b0_0;
    %load/vec4 v0x572d15ea4be0_0;
    %add;
    %assign/vec4 v0x572d15ea43b0_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x572d15eb37c0;
T_1 ;
    %delay 5000, 0;
    %load/vec4 v0x572d15ecf030_0;
    %inv;
    %store/vec4 v0x572d15ecf030_0, 0, 1;
    %jmp T_1;
    .thread T_1;
    .scope S_0x572d15eb37c0;
T_2 ;
    %vpi_call/w 3 23 "$dumpfile", "mac_tb.vcd" {0 0 0};
    %vpi_call/w 3 24 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x572d15eb37c0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x572d15ecf030_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x572d15ecf1a0_0, 0, 1;
    %pushi/vec4 0, 0, 8;
    %store/vec4 v0x572d15eceeb0_0, 0, 8;
    %pushi/vec4 0, 0, 8;
    %store/vec4 v0x572d15ecef90_0, 0, 8;
    %wait E_0x572d15eb1f50;
    %delay 1000, 0;
    %load/vec4 v0x572d15ecf0d0_0;
    %cmpi/ne 0, 0, 32;
    %jmp/0xz  T_2.0, 6;
    %vpi_call/w 3 35 "$display", "FAIL: Reset output expected 0, got %0d", v0x572d15ecf0d0_0 {0 0 0};
    %jmp T_2.1;
T_2.0 ;
    %vpi_call/w 3 37 "$display", "PASS: Reset output = %0d", v0x572d15ecf0d0_0 {0 0 0};
T_2.1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x572d15ecf1a0_0, 0, 1;
    %pushi/vec4 3, 0, 8;
    %store/vec4 v0x572d15eceeb0_0, 0, 8;
    %pushi/vec4 4, 0, 8;
    %store/vec4 v0x572d15ecef90_0, 0, 8;
    %wait E_0x572d15eb1f50;
    %delay 1000, 0;
    %vpi_call/w 3 48 "$display", "Cycle 1: a=%0d b=%0d out=%0d", v0x572d15eceeb0_0, v0x572d15ecef90_0, v0x572d15ecf0d0_0 {0 0 0};
    %wait E_0x572d15eb1f50;
    %delay 1000, 0;
    %vpi_call/w 3 52 "$display", "Cycle 2: a=%0d b=%0d out=%0d", v0x572d15eceeb0_0, v0x572d15ecef90_0, v0x572d15ecf0d0_0 {0 0 0};
    %wait E_0x572d15eb1f50;
    %delay 1000, 0;
    %vpi_call/w 3 56 "$display", "Cycle 3: a=%0d b=%0d out=%0d", v0x572d15eceeb0_0, v0x572d15ecef90_0, v0x572d15ecf0d0_0 {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x572d15ecf1a0_0, 0, 1;
    %wait E_0x572d15eb1f50;
    %delay 1000, 0;
    %vpi_call/w 3 62 "$display", "After reset: out=%0d", v0x572d15ecf0d0_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x572d15ecf1a0_0, 0, 1;
    %pushi/vec4 251, 0, 8;
    %store/vec4 v0x572d15eceeb0_0, 0, 8;
    %pushi/vec4 2, 0, 8;
    %store/vec4 v0x572d15ecef90_0, 0, 8;
    %wait E_0x572d15eb1f50;
    %delay 1000, 0;
    %vpi_call/w 3 71 "$display", "Cycle 4: a=%0d b=%0d out=%0d", v0x572d15eceeb0_0, v0x572d15ecef90_0, v0x572d15ecf0d0_0 {0 0 0};
    %wait E_0x572d15eb1f50;
    %delay 1000, 0;
    %vpi_call/w 3 75 "$display", "Cycle 5: a=%0d b=%0d out=%0d", v0x572d15eceeb0_0, v0x572d15ecef90_0, v0x572d15ecf0d0_0 {0 0 0};
    %vpi_call/w 3 77 "$finish" {0 0 0};
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "mac_tb.v";
    "mac_correct.v";
